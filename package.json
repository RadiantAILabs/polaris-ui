{
	"name": "@radiantailabs/polaris-ui",
	"version": "0.2.2",
	"license": "Apache-2.0",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sass": "./dist/styles/index.scss",
	"style": "./dist/styles/index.css",
	"files": [
		"dist/**",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./components/*": {
			"svelte": "./dist/components/*/index.js",
			"import": "./dist/components/*/index.js",
			"default": "./dist/components/*/index.js"
		},
		"./styles": {
			"sass": "./dist/styles/index.scss",
			"default": "./dist/styles/index.css"
		},
		"./styles/*": "./dist/styles/*",
		"./utils": {
			"types": "./dist/utils.d.ts",
			"import": "./dist/utils.js",
			"default": "./dist/utils.js"
		}
	},
	"typesVersions": {
		"*": {
			"components/*": [
				"dist/components/*/index.d.ts"
			],
			"utils": [
				"dist/utils.d.ts"
			],
			"*": [
				"dist/index.d.ts"
			]
		}
	},
	"peerDependencies": {
		"svelte": "^5.39.6"
	},
	"sideEffects": [
		"**/*.css",
		"**/*.scss"
	],
	"scripts": {
		"dev": "bun run storybook",
		"storybook": "svelte-kit sync && storybook dev -p 6006",
		"storybook:build": "svelte-kit sync && storybook build",
		"generate:icons": "bun run scripts/generate-icons.ts",
		"build": "bun run generate:icons && bun run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"package": "svelte-kit sync && svelte-package -t -o dist && bun run build:styles && publint",
		"build:styles": "bunx sass src/lib/styles/index.scss dist/styles/index.css",
		"prepare": "svelte-kit sync || echo ''",
		"prepublishOnly": "bun run build",
		"lint": "bun run lint:css && bun run lint:eslint && bun run lint:prettier",
		"lint:css": "stylelint 'src/**/*.{css,scss,svelte}'",
		"lint:eslint": "bunx eslint .",
		"lint:prettier": "bunx prettier --check .",
		"fix": "bun run fix:css && bun run fix:eslint && bun run fix:prettier",
		"fix:css": "stylelint 'src/**/*.{css,scss,svelte}' --fix",
		"fix:eslint": "bunx eslint . --fix",
		"fix:prettier": "bunx prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"clean": "rm -rf dist .svelte-kit"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^4.1.1",
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.38.0",
		"@storybook/addon-a11y": "^9.1.3",
		"@storybook/addon-docs": "^9.1.3",
		"@storybook/addon-svelte-csf": "^5.0.8",
		"@storybook/addon-themes": "^9.1.3",
		"@storybook/svelte-vite": "^9.1.3",
		"@sveltejs/kit": "^2.37.0",
		"@sveltejs/package": "^2.5.0",
		"@sveltejs/vite-plugin-svelte": "^6.1.4",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^9.1.2",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.4.0",
		"jiti": "^2.6.1",
		"postcss-html": "^1.8.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"publint": "^0.3.12",
		"sass": "^1.92.0",
		"storybook": "^9.1.4",
		"stylelint": "^16.0.0",
		"stylelint-config-recess-order": "^7.2.0",
		"stylelint-config-standard-scss": "^15.0.1",
		"stylelint-order": "^7.0.0",
		"svelte": "^5.39.6",
		"svelte-check": "^4.3.1",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.46.1",
		"vite": "^7.1.4",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@codemirror/commands": "^6.8.1",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/language": "^6.12.4",
		"@codemirror/state": "^6.5.2",
		"@codemirror/view": "^6.38.2",
		"@internationalized/date": "3.9.0",
		"@lezer/highlight": "^1.2.3",
		"bits-ui": "2.11.4",
		"clsx": "^2.1.1",
		"dompurify": "^3.4.11",
		"marked": "^18.0.6",
		"layerchart": "2.0.1",
		"paneforge": "^1.0.2",
		"svelte-sonner": "^1.0.7",
		"tailwind-variants": "^2.1.0",
		"zod": "^4.0.0"
	},
	"engines": {
		"node": ">=18.0.0",
		"bun": ">=1.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RadiantAILabs/polaris-ui.git"
	},
	"homepage": "https://github.com/RadiantAILabs/polaris-ui",
	"author": "Radiant AI"
}
